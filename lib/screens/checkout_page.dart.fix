// lib/screens/checkout_page.dart (Partial Fix)
// Restoring the correct Stack/Positioned/Column hierarchy for the map overlay

              Positioned(
                bottom: 12,
                right: 12,
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    FloatingActionButton.small(
                      heroTag: 'center_map',
                      backgroundColor: Colors.white,
                      child: const Icon(Icons.center_focus_strong, color: primaryOrange),
                      onPressed: () {
                        if (_selectedLocation != null) {
                          _mapController?.animateCamera(
                            CameraUpdate.newLatLng(_selectedLocation!),
                          );
                        }
                      },
                    ),
                    const SizedBox(height: 8),
                    FloatingActionButton.small(
                      heroTag: 'confirm_pin',
                      backgroundColor: primaryOrange,
                      child: const Icon(Icons.check, color: Colors.white),
                      onPressed: () async {
                        final latLng = await _mapController?.getVisibleRegion();
                        if (latLng != null) {
                          final center = LatLng(
                            (latLng.northeast.latitude + latLng.southwest.latitude) / 2,
                            (latLng.northeast.longitude + latLng.southwest.longitude) / 2,
                          );
                          _reverseGeocode(center);
                        }
                      },
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
